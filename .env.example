# Salin file ini ke .env.local lalu isi dengan config dari Firebase Console
# Firebase Console → Project Settings → Your apps → Web app → firebaseConfig

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 2 akun Google yang diizinkan (pisahkan koma, harus sama dengan firestore.rules)
VITE_ALLOWED_EMAILS=email1@gmail.com,email2@gmail.com
